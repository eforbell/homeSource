{
  "name": "home-source",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Sovereign family document vault — store, organize, and protect household records",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node db/migrate.js",
    "test": "node --test --test-concurrency=1 --require ./test/bootstrap.js test/*.test.js",
    "test:fast": "node --test --test-concurrency=1 --require ./test/bootstrap.js test/*.test.js",
    "test:unit": "node --test --require ./test/bootstrap.js test/auth.test.js test/test-env.test.js test/files.test.js",
    "test:prepare": "DATABASE_URL=postgresql://homesource:homesource@localhost:5438/homesource_test node db/migrate.js",
    "test:schema-parity": "node db/verify-schema-parity.js",
    "magicinsight:eval": "node bin/magicinsight-eval.js",
    "magicindex:preview": "node bin/magicindex-preview.js",
    "worker:import": "node bin/import-worker.js",
    "worker:import:once": "node bin/import-worker.js --once",
    "continuity:check": "node bin/deadman-check.js --once",
    "continuity:outbox": "node bin/continuity-outbox.js --once"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.0",
    "archiver": "^7.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "sharp": "^0.33.0"
  },
  "engines": {
    "node": ">=18"
  }
}
