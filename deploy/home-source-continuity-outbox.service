[Unit]
Description=Home Source — Continuity Reminder Outbox
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=sovereign
Group=sovereign
WorkingDirectory=/opt/sovereign-home/apps/home-source
ExecStart=/usr/bin/node bin/continuity-outbox.js --once
EnvironmentFile=/etc/sovereign-home/home-source.env
StateDirectory=sovereign-home/home-source/data
StandardOutput=journal
StandardError=journal
