DATABASE_URL=postgres://homesource:homesource@localhost:5432/homesource
PORT=3008
STORAGE_PATH=./data
HOUSEHOLD_TIMEZONE=America/New_York
MAX_FILE_SIZE_MB=50

# MagicIndex document metadata extraction (off by default for privacy)
MAGICINDEX_PROVIDER=off
MAGICINDEX_PROVIDER_PRIVATE=no
MAGICINDEX_PROVIDER_DEFAULT=openai_compatible
MAGICINDEX_FETCH_TIMEOUT_MS=90000
MAGICINDEX_AUTO_APPLY_CONFIDENCE=0.85
MAGICINDEX_MAX_PAGES=2
MAGICINDEX_MAX_CHARS=12000
MAGICINDEX_COMPAT_BASE_URL=http://lan-llm:8000/v1
MAGICINDEX_COMPAT_MODEL=qwen3:30b-a3b
MAGICINDEX_COMPAT_API_KEY=
MAGICINDEX_OPENAI_MODEL=gpt-5.4-nano
MAGICINDEX_OPENAI_SEND_PDF=yes
# OPENAI_API_KEY=sk-...

# Sovereign font delivery (default: Google CDN; optional local override)
SOVEREIGN_FONT_SOURCE=google
SOVEREIGN_FONT_SANS_CSS_URL=https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&display=swap
SOVEREIGN_FONT_MONO_CSS_URL=https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap
# Local mode URLs used when SOVEREIGN_FONT_SOURCE=local
SOVEREIGN_FONT_SANS_CSS_URL_LOCAL=http://homebase.local/assets/fonts/source-sans-3.css
SOVEREIGN_FONT_MONO_CSS_URL_LOCAL=http://homebase.local/assets/fonts/jetbrains-mono.css

