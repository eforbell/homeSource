DATABASE_URL=postgres://homesource:homesource@localhost:5432/homesource
PORT=3008
STORAGE_PATH=./data
HOUSEHOLD_TIMEZONE=America/New_York
MAX_FILE_SIZE_MB=50

# MagicIndex document metadata extraction (off by default for privacy)
MAGICINDEX_PROVIDER=off
MAGICINDEX_PROVIDER_PRIVATE=no
MAGICINDEX_PROVIDER_DEFAULT=openai_compatible
MAGICINDEX_FETCH_TIMEOUT_MS=90000
MAGICINDEX_AUTO_APPLY_CONFIDENCE=0.85
MAGICINDEX_MAX_PAGES=2
MAGICINDEX_MAX_CHARS=12000
MAGICINDEX_COMPAT_BASE_URL=http://lan-llm:8000/v1
MAGICINDEX_COMPAT_MODEL=qwen3:30b-a3b
MAGICINDEX_COMPAT_API_KEY=
MAGICINDEX_OPENAI_MODEL=gpt-5.4-nano
MAGICINDEX_OPENAI_SEND_PDF=yes
